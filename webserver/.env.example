# MQTT broker on the Home Assistant VM. This is the currently reachable
# plaintext listener. Prefer mqtts://homeassistant.local:8883 once TLS is
# enabled on the broker, with MQTT_CA_FILE set for a private CA.
MQTT_URL=mqtt://192.168.1.68:1883
MQTT_TOPIC=home/tide/current_height
MQTT_TEMPERATURE_TOPIC=home/tide/water_temperature
MQTT_NEXT_TIDE_TOPIC=home/tide/edgewater/next_tide
MQTT_BATTERY_TOPIC=home/tide/battery_voltage
NEXT_TIDE_TIME_ZONE=America/New_York
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
MQTT_REJECT_UNAUTHORIZED=true

# Payload format: plain (e.g. "1.42") or json (e.g. {"height": 1.42}).
MQTT_PAYLOAD_FORMAT=plain
MQTT_VALUE_PATH=height
MQTT_VALUE_SCALE=1
TIDE_HEIGHT_OFFSET_METERS=-0.10
MQTT_TEMPERATURE_SCALE=1
MQTT_BATTERY_SCALE=1
MQTT_TEMPERATURE_PAYLOAD_FORMAT=plain
MQTT_TEMPERATURE_VALUE_PATH=temperature
TIDE_UNIT=m
TIDE_LOCATION=Church Creek

PORT=3000
DB_PATH=/data/tidegauge.sqlite
RETENTION_DAYS=30
SAMPLE_INTERVAL_SECONDS=300
